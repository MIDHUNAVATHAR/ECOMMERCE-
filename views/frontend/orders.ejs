<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.16/dist/tailwind.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet"/>
</head>
<body class="bg-black"> 

  <!--headefr-->
  <%- include("partials/header") %>  
  <!--header-->

   

  <!--breadcrumb-->
  <nav class="text-sm mb-4 pl-10 pt-5" aria-label="Breadcrumb"> 
    <ol class="list-reset inline-flex items-center space-x-2">
        <li>
            <a href="/" class="text-white hover:text-gray-500">Home</a> 
        </li>
        <li>
            <span class="text-white">/</span>
        </li>
        <li>
            <a href="/userProfile" class="text-white hover:text-gray-500">My Account</a>
        </li>
        <li>
            <span class="text-white">/</span>
        </li>
        <li class="text-white">
            My Orders
        </li>
    </ol>
</nav>
<!--breadcrumb-->



<!--main-->
<!-- Main -->
<div class="container mx-auto mt-8 mb-32 px-4 lg:px-8">
  <div class="flex flex-col lg:flex-row gap-y-6 lg:gap-x-6">
      <!-- Filters Sidebar -->
      <div class="lg:w-1/4 bg-white p-4 rounded-lg shadow-md mb-6 lg:mb-0">
          <h2 class="font-semibold text-lg mb-4">Filters</h2>
          <div class="mb-6">
              <h3 class="font-medium mb-2">ORDER STATUS</h3>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="onTheWay" class="mr-2" <%= orderStatus === 'shipped' ? 'checked' : '' %> value="shipped" onchange="orderStatus(this.value)">
                  <label for="onTheWay">On the way</label>
              </div>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="delivered" class="mr-2" <%= orderStatus === 'delivered' ? 'checked' : '' %> value="delivered" onchange="orderStatus(this.value)">
                  <label for="delivered">Delivered</label>
              </div>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="cancelled" class="mr-2" <%= orderStatus === 'cancelled' ? 'checked' : '' %> value="cancelled" onchange="orderStatus(this.value)">
                  <label for="cancelled">Cancelled</label>
              </div>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="returned" class="mr-2" <%= orderStatus === 'pending' ? 'checked' : '' %> value="pending" onchange="orderStatus(this.value)">
                  <label for="returned">Pending</label>
              </div>
          </div>
          <div>
              <h3 class="font-medium mb-2">ORDER TIME</h3>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="last30Days" class="mr-2" <%= orderTime === '30day' ? 'checked' : '' %> value="30day" onchange="orderTime(this.value)">
                  <label for="last30Days">Last 30 days</label>
              </div>
              <% years.forEach(year => { %>
              <div class="flex items-center mb-2">
                  <input type="checkbox" id="year<%= year %>" class="mr-2" <%= orderTime === year ? 'checked' : '' %> value="<%= year %>" onchange="orderTime(this.value)">
                  <label for="year<%= year %>"><%= year %></label>
              </div>
              <% }) %>
          </div>
      </div>

      <!-- Orders Content -->
      <div class="lg:w-3/4">
          <!-- Current Orders -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <% if (orders.length > 0) { %>
              <% orders.forEach(order => { %>
              <% if (order.orderStatus === "pending" || order.orderStatus === "shipped") { %>
              <div class="border rounded-lg shadow-md p-4 bg-white">
                  <h2 class="text-xl font-bold text-gray-700 mb-2">Order ID: <%= order.orderId ? order.orderId : order._id %></h2>
                  <% if (order.createdAt) { %>
                  <p class="text-gray-600 text-sm">Date: <%= new Date(order.createdAt).toLocaleDateString('en-IN', {
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric'
                  }) %> at <%= new Date(order.createdAt).toLocaleTimeString('en-IN', {
                      hour: '2-digit',
                      minute: '2-digit',
                      hour12: false
                  }) %></p>
                  <% } else { %>
                  <p class="text-gray-600 text-sm">Date: Not available</p>
                  <% } %>

                  <div class="flex items-center mt-4">
                      <% if (order.items.length > 0 && order.items[0].product && order.items[0].product.images && order.items[0].product.images.length > 0) { %>
                      <img src="<%= order.items[0].product.images[0] %>" alt="Product Image" class="w-20 h-20 object-cover rounded-md mr-4">
                      <% } else { %>
                      <img src="/path/to/default-image.jpg" alt="No Image Available" class="w-20 h-20 object-cover rounded-md mr-4">
                      <% } %>

                      <div>
                          <p class="text-sm text-gray-600">Total Price: <span class="font-bold text-green-600">₹<%= order.totalPrice %></span></p>
                          <p class="text-sm text-gray-600">Order Status: 
                              <% if (order.orderStatus === 'delivered') { %>
                              <span class="font-bold text-green-600">Delivered</span>
                              <% } else if (order.orderStatus === "cancelled") { %>
                              <span class="font-bold text-red-500">Order Cancelled</span>
                              <% } else { %>
                              <span class="font-bold text-red-900"><%= order.orderStatus %></span>
                              <p class="text-sm text-gray-600">Payment Status: <span class="font-bold text-red-500"><%= order.paymentStatus %></span></p>
                              <% } %>
                          </p>
                          <% if (order.items && order.items.some(item => item.itemStatus === 'cancelled')) { %>
                            <p class="mt-1 text-xs font-bold text-red-600">Cancelled product in this order</p>
                          <% } %>
                      </div>
                  </div>

                  <div class="mt-6 flex justify-between">
                      <button type="button" class="text-white bg-red-500 hover:bg-red-600 font-semibold py-2 px-4 rounded-lg disabled:bg-gray-400 disabled:cursor-not-allowed"
                              <%= (order.productCancellationLocked || order.items.some(item => item.itemStatus === 'cancelled')) ? 'disabled' : '' %>
                              onclick="openCancelModal('<%= order._id %>')">
                          Cancel Order
                      </button>
                      <a href="/myOrders/<%= order._id %>" class="text-white bg-blue-500 hover:bg-blue-600 font-semibold py-2 px-4 rounded-lg">
                          View Order
                      </a>
                  </div>
              </div>
              <% } %>
              <% }) %>
              <% } else { %>
              <div class="text-center col-span-full">
                  <p class="text-gray-600 text-lg">No orders found.</p>
              </div>
              <% } %>
          </div>

          <!-- Previous Orders -->
          <h1 class="mt-10 mb-10 text-3xl font-extrabold text-gray-700 tracking-wide">Previous Orders</h1>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <% if (orders.length > 0) { %>
              <% orders.forEach(order => { %>
              <% if (order.orderStatus === "delivered" || order.orderStatus === "cancelled") { %>
              <div class="border rounded-lg shadow-md p-4 bg-white">
                  <h2 class="text-xl font-bold text-gray-700 mb-2">Order ID: <%= order.orderId ? order.orderId : order._id %></h2>
                  <p class="text-gray-600 text-sm">Date: <%= new Date(order.createdAt).toLocaleDateString('en-IN', {
                      day: '2-digit',
                      month: '2-digit',
                      year: 'numeric'
                  }) %> at <%= new Date(order.createdAt).toLocaleTimeString('en-IN', {
                      hour: '2-digit',
                      minute: '2-digit',
                      hour12: false
                  }) %></p>

                  <div class="flex items-center mt-4">
                      <% if (order.items.length > 0 && order.items[0].product && order.items[0].product.images && order.items[0].product.images.length > 0) { %>
                      <img src="<%= order.items[0].product.images[0] %>" alt="Product Image" class="w-20 h-20 object-cover rounded-md mr-4">
                      <% } else { %>
                      <img src="/path/to/default-image.jpg" alt="No Image Available" class="w-20 h-20 object-cover rounded-md mr-4">
                      <% } %>

                      <div>
                          <p class="text-sm text-gray-600">Total Price: <span class="font-bold text-green-600">₹<%= order.totalPrice %></span></p>
                          <p class="text-sm text-gray-600">Order Status: 
                              <% if (order.orderStatus === 'delivered') { %>
                              <span class="font-bold text-green-600">Delivered</span>
                              <% } else { %>
                              <span class="font-bold text-red-500"><%= order.orderStatus %></span>
                              <% } %>
                          </p>
                          <% if (order.items && order.items.some(item => item.itemStatus === 'cancelled')) { %>
                            <p class="mt-1 text-xs font-bold text-red-600">Cancelled product in this order</p>
                          <% } %>
                      </div>
                  </div>

                  <div class="mt-4 flex justify-between">
                      <% if (order.orderStatus === 'delivered' && !order.returnRequested) { %>
                      <a href="/returnOrder/<%= order._id %>" class="text-white bg-red-500 hover:bg-red-600 font-semibold py-2 px-4 rounded-lg">
                          Return Order
                      </a>

                                             <!-- Leave Review Button -->
            
                                       <!-- Button to trigger the modal (only if the order is delivered and the product ID exists) -->
<% if (order.orderStatus === 'delivered' && order.items.length > 0 && order.items[0].product && order.items[0].product._id) { %>
  <button type="button" class="bg-yellow-500 mt-5 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded " onclick="openReviewModal('<%= order.items[0].product._id %>')">
    Leave a Review
  </button>
  
<% } %>
                      <% } %>
                      <a href="/myOrders/<%= order._id %>" class="text-white bg-blue-500 hover:bg-blue-600 font-semibold py-2 px-4 rounded-lg">
                          View Order
                      </a>
                  </div>
              </div>
              <% } %>
              <% }) %>
              <% } else { %>
              <div class="text-center col-span-full">
                  <p class="text-gray-600 text-lg">No orders found.</p>
              </div>
              <% } %>
          </div>
      </div>
  </div>
</div>
<!-- Main -->

<!--main-->


  <!--footer-->
  <%- include("partials/footer") %>
  <!--footer-->


    <!-- Modal Structure -->
<div id="reviewModal" class="fixed inset-0 bg-gray-800 bg-opacity-50 flex items-center justify-center hidden">
  <div class="bg-white p-6 rounded-lg shadow-lg w-96">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold">Leave a Review</h2>
      <button onclick="closeReviewModal()" class="text-gray-600 hover:text-red-600">&times;</button>
    </div>

    <!-- Review Form -->
    <form id="reviewForm">
      <input type="hidden" id="productId" name="productId" value="">

      <!-- Rating -->
      <div class="mb-4">
        <label class="block text-gray-700">Rating:</label>
        <div class="flex">
          <!-- Stars (clickable) -->
          <span class="text-gray-400 text-2xl cursor-pointer" onclick="setRating(1)">&#9734;</span>
          <span class="text-gray-400 text-2xl cursor-pointer" onclick="setRating(2)">&#9734;</span>
          <span class="text-gray-400 text-2xl cursor-pointer" onclick="setRating(3)">&#9734;</span>
          <span class="text-gray-400 text-2xl cursor-pointer" onclick="setRating(4)">&#9734;</span>
          <span class="text-gray-400 text-2xl cursor-pointer" onclick="setRating(5)">&#9734;</span>
        </div>
        <input type="hidden" id="rating" name="rating" value="1">
      </div>

      <!-- Comment -->
      <div class="mb-4">
        <label class="block text-gray-700">Comment:</label>
        <textarea id="comment" name="comment" rows="4" class="w-full p-2 border rounded-lg" required></textarea>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded w-full">Submit Review</button>
    </form>
  </div>
</div>

<div id="cancelProductModal" class="fixed inset-0 bg-gray-900 bg-opacity-60 flex items-center justify-center hidden z-50">
  <div class="bg-white rounded-lg shadow-lg w-11/12 max-w-2xl p-6">
    <div class="flex justify-between items-start gap-4 mb-4">
      <div>
        <h2 class="text-xl font-bold text-gray-800">Cancel Product</h2>
        <p class="text-sm text-red-600 mt-1">Once any product is cancelled from this order, you cannot cancel other products from the same order.</p>
      </div>
      <button type="button" onclick="closeCancelModal()" class="text-2xl leading-none text-gray-500 hover:text-red-600">&times;</button>
    </div>

    <div id="cancelProductList" class="space-y-3 max-h-96 overflow-y-auto"></div>

    <div class="mt-5 flex justify-end gap-3">
      <button type="button" onclick="closeCancelModal()" class="px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">Close</button>
      <button type="button" id="confirmProductCancelBtn" onclick="confirmProductCancellation()" class="px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 disabled:bg-gray-400 disabled:cursor-not-allowed" disabled>
        Cancel Selected Product
      </button>
    </div>
  </div>
</div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const cancelOrders = <%- JSON.stringify(orders.map(order => ({
      id: order._id,
      locked: Boolean(order.productCancellationLocked || (order.items && order.items.some(item => item.itemStatus === 'cancelled'))),
      appliedCoupon: order.appliedCoupon || 0,
      items: (order.items || []).map(item => ({
        id: item._id,
        title: item.product && item.product.title ? item.product.title : item.title,
        image: item.product && item.product.images && item.product.images.length > 0 ? item.product.images[0] : '',
        size: item.size,
        quantity: item.quantity,
        totalPrice: item.totalPrice,
        status: item.itemStatus || 'active'
      }))
    }))).replace(/</g, '\\u003c') %>;
    let selectedCancelOrderId = '';
    let selectedCancelItemId = '';

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[char]));
    }
     
    function orderStatus(status){
      const currentUrl = new URL(window.location.href) ; 
      if(currentUrl.searchParams.get("orderStatus")== status ){
        currentUrl.searchParams.delete('orderStatus') ;
        window.location.href = currentUrl.href ; 
      }else{
        currentUrl.searchParams.set("orderStatus",status) ;
        window.location.href = currentUrl.href ; 
      }
    }

    function orderTime(time){
      const currentUrl = new URL( window.location.href ) ; 
      if(currentUrl.searchParams.get("orderTime") == time ){
        currentUrl.searchParams.delete('orderTime') ;
        window.location.href = currentUrl.href ; 
      }else{
        currentUrl.searchParams.set("orderTime",time) ;
        window.location.href = currentUrl.href ; 
      }
    }


    function openCancelModal(orderId) {
      const order = cancelOrders.find(order => order.id === orderId);
      const list = document.getElementById('cancelProductList');
      const confirmBtn = document.getElementById('confirmProductCancelBtn');

      selectedCancelOrderId = orderId;
      selectedCancelItemId = '';
      confirmBtn.disabled = true;
      list.innerHTML = '';

      if (!order || order.locked) {
        list.innerHTML = '<p class="text-red-600 font-semibold">A product from this order is already cancelled. You cannot cancel another product.</p>';
      } else {
        order.items.forEach(item => {
          const disabled = item.status === 'cancelled';
          const refundPreview = Math.max(Number(item.totalPrice || 0) - Number(order.appliedCoupon || 0), 0).toFixed(2);
          const itemTitle = escapeHtml(item.title || 'Product');
          const row = document.createElement('label');
          row.className = `flex items-center gap-3 border rounded-lg p-3 ${disabled ? 'bg-gray-100 opacity-70' : 'cursor-pointer hover:bg-gray-50'}`;
          row.innerHTML = `
            <input type="radio" name="cancelProductItem" value="${item.id}" class="h-4 w-4" ${disabled ? 'disabled' : ''}>
            ${item.image ? `<img src="${escapeHtml(item.image)}" alt="${itemTitle}" class="w-14 h-14 object-cover rounded">` : '<div class="w-14 h-14 bg-gray-200 rounded"></div>'}
            <div class="flex-1">
              <p class="font-semibold text-gray-800">${itemTitle}</p>
              <p class="text-sm text-gray-600">Size: ${escapeHtml(item.size)} | Qty: ${Number(item.quantity || 0)} | Subtotal: ₹${Number(item.totalPrice || 0).toFixed(2)}</p>
              <p class="text-xs text-gray-500">Estimated wallet credit after coupon deduction: ₹${refundPreview}</p>
            </div>
            ${disabled ? '<span class="text-xs font-bold text-red-600">Cancelled</span>' : ''}
          `;
          row.querySelector('input').addEventListener('change', (event) => {
            selectedCancelItemId = event.target.value;
            confirmBtn.disabled = false;
          });
          list.appendChild(row);
        });
      }

      document.getElementById('cancelProductModal').classList.remove('hidden');
    }

    function closeCancelModal() {
      document.getElementById('cancelProductModal').classList.add('hidden');
    }

    //cancel selected product
    function confirmProductCancellation(){
      if (!selectedCancelOrderId || !selectedCancelItemId) {
        toastr.error('Please select a product to cancel.');
        return;
      }

      Swal.fire({
      title  : 'Are you sure?',
      text:  "Cancel the selected product from this order?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#3085d6',
      cancelButtonColor: '#d33',
      confirmButtonText: 'Yes, Cancel it!',
      cancelButtonText: 'Cancel'
    }).then((result) => {          
      if (result.isConfirmed) {
        // Trigger the API call if confirmed
        fetch('/cancelOrder', {
          method: 'POST',
          headers: {
            'Content-Type'  : 'application/json'
          },
          body : JSON.stringify({ id: selectedCancelOrderId, itemId: selectedCancelItemId })
        })
        .then(response => response.json())
        .then(data => {
          if (data.status) {
            Swal.fire(
              'Cancell!',
              'Your item has been cancelled.',
              'success'
            );

    
            if(data.wallet){
             toastr.success(`${data.wallet} added to your wallet`, 'Wallet');
             }

            closeCancelModal();
            setTimeout(()=>location.reload() , 3000)
          } else {
            Swal.fire(
              'Error!',
              data.message || 'There was a problem cancelling your item.',
              'error'
            );
          }
        })
        .catch(error => {
          Swal.fire(
              'Cancell!',
              'Your item has been cancelled.',
              'success'
            );
            setTimeout(()=>location.reload() , 3000)
        });
      }
    });
    }


  
   // Function to open the modal
  function openReviewModal(productId) {
    document.getElementById('reviewModal').classList.remove('hidden') ; 
    document.getElementById('productId').value = productId ;
  }

  // Function to close the modal
  function closeReviewModal() {
    document.getElementById('reviewModal').classList.add('hidden') ;    
  }



  // Function to set the rating by clicking stars
  function setRating(rating) {
    document.getElementById('rating').value = rating;
    let stars = document.querySelectorAll('#reviewModal .text-2xl'); 
    stars.forEach((star, index) => {
      star.classList.toggle('text-yellow-500', index < rating);
      star.classList.toggle('text-gray-400', index >= rating);
    });
  }



  // Submit the review form via AJAX
  document.getElementById('reviewForm').addEventListener( 'submit', function (event) {
    event.preventDefault(); 

    const productId = document.getElementById('productId').value;
    const rating = document.getElementById('rating').value;
    const comment = document.getElementById('comment').value;

    fetch('/submitReview', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId , rating , comment })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
       // alert('Review submitted successfully!');
       Swal.fire(
              'Submitted',
              'Review submitted successfully.',
              'success'
            );
        closeReviewModal();
      } else {
        alert('Error submitting review.');
      }
    })
    .catch(error => console.error( 'Error:' , error )) ; 
  });

  </script>

</body>
</html>
